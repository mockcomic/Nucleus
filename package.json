{
  "name": "radial-wheel",
  "productName": "Radial Wheel",
  "version": "1.0.0",
  "description": "A polished, always-running radial launcher menu for Windows",
  "main": "src/main/main.js",
  "author": "Radial Wheel",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "start:agent": "node scripts/start-agent.js",
    "start:hidden": "wscript scripts/launch-hidden.vbs",
    "make-icons": "node scripts/make-icons.mjs",
    "build": "npm run dist",
    "dist": "node scripts/make-icons.mjs && node scripts/bump-build.mjs && electron-builder",
    "test": "node --test tests/*.test.js tests/unit/*.test.js"
  },
  "dependencies": {
    "koffi": "^2.9.2"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.radialwheel",
    "productName": "Radial Wheel",
    "buildNumber": "9",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/tray.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "RadialWheel-${version}-b${buildNumber}-setup.exe",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "RadialWheel-${version}-b${buildNumber}-portable.exe"
    }
  }
}

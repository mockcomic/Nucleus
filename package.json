{
  "name": "nucleus-launcher",
  "productName": "Nucleus",
  "version": "1.1.1",
  "description": "A polished, always-running radial launcher for Windows",
  "main": "src/main/main.js",
  "author": "Nucleus",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/start-agent.js",
    "dev:watch": "electronmon . --user-data-dir=.dev-userdata",
    "start:agent": "node scripts/start-agent.js",
    "start:hidden": "wscript scripts/launch-hidden.vbs",
    "make-icons": "node scripts/make-icons.mjs",
    "build": "npm run dist",
    "dist": "node scripts/make-icons.mjs && node scripts/bump-build.mjs && electron-builder",
    "test": "node --test tests/*.test.js tests/unit/*.test.js"
  },
  "dependencies": {
    "koffi": "^2.9.2",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.0.12",
    "electronmon": "^2.0.4"
  },
  "electronmon": {
    "patterns": [
      "!.dev-userdata/**",
      "!dist/**",
      "!tests/**"
    ]
  },
  "build": {
    "appId": "local.nucleus",
    "productName": "Nucleus",
    "buildNumber": "0",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/tray.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Nucleus-${version}-b${buildNumber}-setup.exe",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Nucleus-${version}-b${buildNumber}-portable.exe"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "koffi@2.16.3": true
  }
}
